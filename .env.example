# Image generation providers
# Only the provider you use needs a key.

OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# Overrides (optional)
# CBG_PROVIDER=openai
# CBG_MODEL=gpt-image-1

# ChatGPT Plus / Codex (device-code login: `cbg auth codex`)
# Optional: read an existing token file from another project instead of ~/.config
# CBG_CODEX_AUTH=/path/to/openai_codex_auth.json
# CBG_CODEX_MODEL=
# CBG_CODEX_IMAGE_MODEL=gpt-image-2
# CBG_CODEX_IMAGE_QUALITY=medium
# CBG_CODEX_CLIENT_VERSION=0.130.0
